[Unit]
Description=Bopomofo API on port %i
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=bopomofo-api
Group=bopomofo-api
# Two slots, bopomofo-api@8765 and bopomofo-api@8766, so a new release starts next to the running one.
# bopomofo-deploy points /opt/bopomofo/slots/<port> at the release a slot runs, and Caddy at the port that serves.
WorkingDirectory=/opt/bopomofo/slots/%i/backend
EnvironmentFile=/etc/bopomofo/api.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/bopomofo
Environment=MODEL_DIR=/opt/bopomofo/shared/models
Environment=DATA_DIR=/var/lib/bopomofo/data
# The ARM VPS profile: at most 4 threads for speech and 4 for voices (backend/app/runtime.py).
Environment=SPEECH_RUNTIME=vps
# On stop, uvicorn finishes the requests in progress (at most 60 s, enough for a speech upload) before it exits.
ExecStart=/opt/bopomofo/slots/%i/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port %i --workers 1 --timeout-graceful-shutdown 60
TimeoutStopSec=75
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/bopomofo

[Install]
WantedBy=multi-user.target
