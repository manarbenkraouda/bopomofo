# /etc/bopomofo/deploy.env, mode 600, read by /usr/local/sbin/bopomofo-deploy.
DEPLOY_BRANCH=main
# The tests run on this database before every deploy. Never put the production database here.
TEST_DATABASE_URL=postgresql://bopomofo_app:PASSWORD@127.0.0.1:5432/bopomofo_test
# Set to 0 to stop posting each deploy result as a commit status on GitHub.
GITHUB_STATUS=1
