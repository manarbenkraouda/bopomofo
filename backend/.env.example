OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# PostgreSQL. Use a normal role that owns the database: not a superuser, no BYPASSRLS (see docs/setup/README.md).
DATABASE_URL=postgresql://bopomofo_app:PASSWORD@127.0.0.1:5432/bopomofo
# Tests empty this database. Never point it at DATABASE_URL.
TEST_DATABASE_URL=postgresql://bopomofo_app:PASSWORD@127.0.0.1:5432/bopomofo_test

# Clerk: use the same application as frontend/.env.local (see docs/setup/README.md).
CLERK_SECRET_KEY=
# Production: the frontend origins allowed to use the session tokens, comma separated.
CLERK_AUTHORIZED_PARTIES=

# Keep the last reading quiz clips per user in data/quiz_clips (threshold tuning). Off by default.
SAVE_QUIZ_CLIPS=
# The time zone of a learner who has not chosen one yet. Days, streaks, and daily goals follow the learner's zone.
DEFAULT_TIMEZONE=UTC
# Speech and voice tuning: local (this laptop, every core) or vps (at most 4 threads). Empty: vps on Linux, else local.
SPEECH_RUNTIME=
