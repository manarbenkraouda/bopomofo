# Editor settings shared by the backend (Python) and the frontend (TypeScript). See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,mjs}]
max_line_length = 120

[*.{cmd,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false